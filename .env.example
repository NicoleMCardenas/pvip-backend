
# Application
APP_NAME=KAIRO
APP_ENV=development

# Database
# Replace with the connection URL for your environment.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# Authentication
# Generate a unique, strong secret for each environment.
JWT_SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email notifications
RESEND_API_KEY=
EMAIL_FROM=
SURVEY_PUBLIC_BASE_URL=
EMAIL_SENDING_ENABLED=false

# Password recovery
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
PASSWORD_RESET_PUBLIC_BASE_URL=
PASSWORD_RESET_EMAIL_ENABLED=false

# Staff invitations
STAFF_INVITATION_TOKEN_EXPIRE_HOURS=48
STAFF_INVITATION_PUBLIC_BASE_URL=
